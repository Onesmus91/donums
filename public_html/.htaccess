# Donums platform — Apache / LiteSpeed
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS (uncomment once your SSL certificate is active)
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Static files that may be served directly
RewriteRule ^assets/ - [L]
RewriteRule ^\.well-known/ - [L]
RewriteRule ^(sw\.js|manifest\.webmanifest|offline\.html|robots\.txt|favicon\.ico|errors/.*\.html)$ - [L]
RewriteRule ^cron\.php$ - [L]

# Everything else — including any leftover legacy .php files — goes through the router.
RewriteRule ^ index.php [L,QSA]
</IfModule>

# Never allow script execution or listing inside upload folders
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Compression and caching for static assets
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 6 months"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType text/css "access plus 1 week"
ExpiresByType application/javascript "access plus 1 week"
</IfModule>

ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 500 /errors/500.html
